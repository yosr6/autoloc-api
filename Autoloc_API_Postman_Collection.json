        {
          "name": "GET - Lister tous les véhicules",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/vehicules",
              "host": ["{{baseUrl}}"],
              "path": ["api", "vehicules"]
            }
